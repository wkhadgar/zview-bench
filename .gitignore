# data: of each Kconfig footprint build tree keep only the binary, map, size report and config
/data/*/footprint-out/b-*/**
!/data/*/footprint-out/b-*/**/
!/data/*/footprint-out/b-*/zephyr/zephyr.elf
!/data/*/footprint-out/b-*/zephyr/zephyr.map
!/data/*/footprint-out/b-*/zephyr/zephyr.stat
!/data/*/footprint-out/b-*/zephyr/.config

