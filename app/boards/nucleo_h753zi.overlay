 *
 * bench_toggle drives an external probe point for a logic analyzer / scope,
 * giving a target-independent reference for the steady-state period. PB8 is
 * Arduino D15 on the Nucleo-144 header.
 */

/ {
	bench {
		compatible = "gpio-leds";
		bench_toggle: bench_toggle {
			gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		bench-toggle = &bench_toggle;
	};
};
