 * SPDX-License-Identifier: Apache-2.0
 *
 * led0 drives an external probe point for a logic analyzer / scope, giving a
 * target-independent reference for the steady-state period. It is moved off
 * the green user LED (LD1) to PB8, Arduino D15 on the Nucleo-144 header.
 *
 * button0 is the blue user button (B1), which the board names sw0.
 */

/ {
	bench {
		compatible = "gpio-leds";
		bench_toggle: bench_toggle {
			gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		led0 = &bench_toggle;
		button0 = &user_button;
	};
};
